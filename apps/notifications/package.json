{
  "name": "@innogram/notifications-microservice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "start": "NOTIFICATIONS_HTTP_PORT=3006 node dist/main.js",
    "start:dev": "npm run build && NOTIFICATIONS_HTTP_PORT=3006 node dist/main.js",
    "start:watch": "NOTIFICATIONS_HTTP_PORT=3006 tsx watch src/main.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.17",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.17",
    "@nestjs/microservices": "^10.4.17",
    "@nestjs/platform-express": "^10.4.17",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
