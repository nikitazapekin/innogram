{
  "name": "@innogram/core-microservice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && npm run build:shared && tsc -p tsconfig.build.json",
    "build:shared": "npm --prefix ../../packages/shared run build",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "start:watch": "npm run build:shared && tsx watch src/main.ts",
    "start:abc": "nest start --watch",
    "migration:generate": "typeorm-ts-node-commonjs -d src/data-source.ts migration:generate src/database/migrations/GeneratedMigration",
    "migration:run": "typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^10.4.17",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.17",
    "@nestjs/microservices": "^10.4.17",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.7",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.24"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/minio": "^7.1.0",
    "@types/multer": "^2.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3"
  }
}
