{
  "name": "@innogram/api-gateway",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run clean && npm run build:shared && tsc -p tsconfig.build.json",
    "build:shared": "npm --prefix ../../packages/shared run build",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@innogram/shared": "*",
    "@nestjs/common": "^10.4.17",
    "@nestjs/core": "^10.4.17",
    "@nestjs/microservices": "^10.4.17",
    "@nestjs/platform-express": "^10.4.17",
    "dotenv": "^16.6.1",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
