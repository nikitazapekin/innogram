{
  "name": "@innogram/auth-microservice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "start": "node dist/server.js",
    "start:dev": "npm run build && node dist/server.js",
    "start:watch": "tsx watch src/server.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6"
  }
}
