{
  "name": "@innogram/auth-microservice",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run clean && npm run build:shared && tsc -p tsconfig.build.json && cp src/openapi.yaml dist/openapi.yaml",
    "build:shared": "npm --prefix ../../packages/shared run build",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@innogram/shared": "*",
    "@nestjs/microservices": "^10.4.17",
    "@sentry/node": "^9.28.0",
    "axios": "^1.16.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "kafkajs": "^2.2.4",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/swagger-ui-express": "^4.1.8"
  }
}
