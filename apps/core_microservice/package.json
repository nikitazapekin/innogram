{
  "name": "@innogram/core-microservice",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:shared": "npm --prefix ../../packages/shared run build",
    "build": "npm run build:shared && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "start:watch": "npm run build:shared && tsx watch src/main.ts",
    "migration:generate": "tsx ../../node_modules/typeorm/cli.js -d src/database.config.ts migration:generate src/database/migrations/GeneratedMigration",
    "migration:run": "tsx ../../node_modules/typeorm/cli.js -d src/database.config.ts migration:run",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@innogram/shared": "file:../../packages/shared",
    "@nestjs/common": "^10.4.17",
    "@nestjs/core": "^10.4.17",
    "@nestjs/microservices": "^10.4.17",
    "@nestjs/platform-express": "^10.4.17",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.24"
  }
}
