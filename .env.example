# =============================================================================
# Innogram Environment Configuration
# Copy to .env and fill in values. See docs/ENVIRONMENT.md for full reference.
# =============================================================================

# --- Global ---
NODE_ENV=development
APP_VERSION=1.0.0
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- API Gateway ---
API_GATEWAY_PORT=3004
API_GATEWAY_URL=http://localhost:3004
AUTH_SERVICE_URL=http://localhost:3002
CORE_URL=http://localhost:3001

# --- Core ---
CORE_HTTP_PORT=3001
SWAGGER_PATH=api/docs
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=innogram
CORE_REDIS_URL=redis://localhost:6379
CORE_REDIS_KEY_PREFIX=innogram:core
ASSET_URL_CACHE_TTL_SECONDS=10800
POSTS_FEED_CACHE_TTL_SECONDS=30
SLOW_QUERY_THRESHOLD_MS=100
RUN_MIGRATIONS=false
KAFKA_BROKERS=localhost:9092
MENTION_EVENTS_TOPIC=mention.events

# --- MinIO / S3 ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=main

# --- Auth ---
AUTH_HTTP_PORT=3002
AUTH_SWAGGER_PATH=api/docs
AUTH_SERVICE_NAME=auth-microservice
AUTH_SERVER_REQUEST_TIMEOUT_MS=30000
AUTH_JWT_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_JWT_ACCESS_TOKEN_KEY_ID=
AUTH_JWT_ACCESS_TOKEN_PRIVATE_KEY=
AUTH_JWT_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_JWT_REFRESH_TOKEN_SECRET=
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_REDIS_URL=redis://localhost:6379
AUTH_REDIS_KEY_PREFIX=innogram:auth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:3002/auth/google/callback
AUTH_ALLOWED_OAUTH_REDIRECT_ORIGINS=http://localhost:3000
AUTH_CORE_SIGNUP_TOPIC=auth.signup
AUTH_CORE_HTTP_URL=http://localhost:3001

# --- Notifications ---
NOTIFICATIONS_HTTP_PORT=3005
NOTIFICATIONS_SERVICE_URL=http://localhost:3005
NOTIFICATIONS_POSTGRES_HOST=localhost
NOTIFICATIONS_POSTGRES_PORT=5433
NOTIFICATIONS_POSTGRES_USER=postgres
NOTIFICATIONS_POSTGRES_PASSWORD=postgres
NOTIFICATIONS_POSTGRES_DATABASE=innogram

# --- Client (Next.js) ---
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3004
NEXT_PUBLIC_CORE_URL=http://localhost:3001
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=localhost:9000

# --- Docker Compose overrides ---
CLIENT_PORT=3000
REDIS_PORT=6379
KAFKA_PORT=9092

# --- Nginx reverse proxy + CDN (docker compose --profile proxy) ---
NGINX_PORT=80
NGINX_SERVER_NAME=localhost
# With nginx profile, rebuild client using path-based URLs:
# NEXT_PUBLIC_API_GATEWAY_URL=http://localhost/api
# NEXT_PUBLIC_CORE_URL=http://localhost/core
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=localhost/media
