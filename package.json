{
  "name": "innogram",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/api-gateway",
    "apps/auth",
    "apps/notifications",
    "apps/client_app",
    "apps/core",
    "packages/shared"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "lint:packages": "turbo run lint --filter=./packages/*",
    "clean": "turbo run clean",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "prepare": "husky",
    "start:core": "npm --prefix apps/core run start:dev",
    "start:gateway": "npm --prefix apps/api-gateway run start:dev",
    "start:all": "turbo run start:dev --parallel --filter=@innogram/core-microservice --filter=@innogram/auth-microservice --filter=@innogram/api-gateway",
    "build:shared": "npm --prefix packages/shared run build",
    "build:core": "npm --prefix apps/core run build",
    "start:core:prod": "node apps/core/dist/main.js",
    "start:all:prod": "concurrently -n gateway,auth,core,notif,client -c blue,green,yellow,magenta,cyan \"npm --prefix apps/api-gateway run build && npm --prefix apps/api-gateway run start\" \"npm --prefix apps/auth run build && npm --prefix apps/auth run start\" \"npm --prefix apps/core run build && npm --prefix apps/core run start\" \"npm --prefix apps/notifications run build && npm --prefix apps/notifications run start\" \"npm --prefix apps/client_app run build && npm --prefix apps/client_app run dev\""
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@nestjs/config": "^4.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-express": "^0.68.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-ioredis": "^0.68.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.29.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.66.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  }
}
