{
  "name": "innogram",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/core_microservice",
    "apps/auth_microservice",
    "apps/posts_microservice",
    "packages/shared"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "start:core": "npm --prefix apps/core_microservice run start:dev",
    "start:auth": "npm --prefix apps/auth_microservice run start:dev",
    "start:posts": "npm --prefix apps/posts_microservice run start:dev",
    "start:all": "turbo run start:dev --parallel --filter=@innogram/core-microservice --filter=@innogram/auth-microservice --filter=@innogram/posts-microservice",
    "build:shared": "npm --prefix packages/shared run build",
    "build:core": "npm --prefix apps/core_microservice run build",
    "build:auth": "npm --prefix apps/auth_microservice run build",
    "build:posts": "npm --prefix apps/posts_microservice run build",
    "start:core:prod": "node apps/core_microservice/dist/main.js",
    "start:auth:prod": "node apps/auth_microservice/dist/main.js",
    "start:posts:prod": "node apps/posts_microservice/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "turbo": "^2.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
